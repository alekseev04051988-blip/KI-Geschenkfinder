{
  "functions": {
    "api/geschenke.js": {
      "includeFiles": "gifts.json"
    }
  },
  "headers": [
    {
      "source": "/impressum",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/impressum.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/datenschutz",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/datenschutz.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/idee/:slug",
      "destination": "/api/g?slug=:slug"
    },
    {
      "source": "/geschenke",
      "destination": "/api/geschenke"
    },
    {
      "source": "/geschenke/:slug",
      "destination": "/api/geschenke?slug=:slug"
    },
    {
      "source": "/impressum",
      "destination": "/impressum.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/datenschutz.html"
    }
  ]
}
